{
  "run_mode": "full",
  "window": 48,
  "horizon": 24,
  "split_ratios": [
    0.7,
    0.15,
    0.15
  ],
  "profile": {
    "max_points": 20000,
    "seeds": [
      42,
      123,
      2024,
      7,
      99
